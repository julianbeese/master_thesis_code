<gidredirect oldgid="uk.org.publicwhip/westminhall/2018-05-22a.327.3" newgid="uk.org.publicwhip/westminhall/2018-05-22b.327.3" matchtype="perfectmatch"/>
<gidredirect oldgid="uk.org.publicwhip/westminhall/2018-05-22a.328.0" newgid="uk.org.publicwhip/westminhall/2018-05-22b.328.0" matchtype="perfectmatch"/>
